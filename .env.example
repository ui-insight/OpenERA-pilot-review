# ==============================================================================
# {{PROJECT_NAME}} — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit the .env file to version control.
# ==============================================================================

# --- Database ---
# Standard local/deployed database (PostgreSQL):
POSTGRES_DB=pilot_review
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pilot_review

# Optional SQLite fallback for isolated experiments only:
# DATABASE_URL=sqlite+aiosqlite:///./app.db

# --- Authentication ---
# IMPORTANT: Change this in production. The app will refuse to start in
# production mode with the default key.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Application ---
DEV_MODE=true
UPLOAD_DIR=./uploads
CORS_ORIGINS=["http://localhost:5173","http://localhost:9200"]

# --- Seed Data ---
SEED_ON_STARTUP=true

# --- AI Services (optional) ---
# Configure if your application uses AI/LLM features.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
